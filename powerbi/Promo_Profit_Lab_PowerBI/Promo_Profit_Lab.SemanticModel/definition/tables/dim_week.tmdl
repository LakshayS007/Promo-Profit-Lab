	partition dim_week = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_week.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"week", Int64.Type}, {"week_start", type date}, {"month", type text}, {"month_num", Int64.Type}, {"quarter", type text}, {"half", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
