				let
				    Source = Csv.Document(File.Contents(DataFolder & "plan_bridge.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Index", Int64.Type}, {"step", type text}, {"per_million", Int64.Type}}, "en-US")
