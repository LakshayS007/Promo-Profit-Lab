                      "fontSize": "10pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Redesign the 8 Fix lines. ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#111827"
                    }
                  },
                  {
                    "value": "Cut the extra discount by 5 points and move budget to the lines that lose least: +$153k per $1M with the same total spend.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
