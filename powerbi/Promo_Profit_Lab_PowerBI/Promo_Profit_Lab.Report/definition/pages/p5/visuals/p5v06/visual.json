                      "fontSize": "10pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Prove campaigns. ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#111827"
                    }
                  },
                  {
                    "value": "Hold out 10\u201320% of households in every campaign; about 7,850 per group detects a 3% lift.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pilot first: ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#111827"
                    }
                  },
                  {
                    "value": "two Fix categories for 6 weeks, then scale. Main risks: supplier push-back and price perception.",
