              },
              {
                "textRuns": [
                  {
                    "value": "1. Gate on supplier funding. ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#111827"
                    }
                  },
                  {
                    "value": "A promotion runs only if its supplier funds its break-even share: 0% for displays and deli, up to 59% for grocery price cuts.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#374151"
                    }
