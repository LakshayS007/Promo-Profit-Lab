flowchart LR
  subgraph CM[Category manager]
    A1[Draft quarterly promo calendar<br/>from last year's plan] --> A2[Pick items and discount depth<br/>by gut feel and supplier asks]
  end
  subgraph SUP[Supplier]
    S1[Offer co-funding<br/>case by case]
  end
  subgraph MKT[Marketing]
    M1[Choose mailer and display slots] --> M2[Send targeted campaigns<br/>to best shoppers]
  end
  subgraph FIN[Finance]
    F1[Report promo sales uplift<br/>vs last year]
  end
  A2 --> S1 --> M1
  M2 --> F1
  F1 -. "success = sales up" .-> A1
  P1{{"Pain 1: no profit check before a promotion runs"}}:::pain
  P2{{"Pain 2: supplier funding negotiated without a break-even target"}}:::pain
  P3{{"Pain 3: campaigns judged against non-targeted shoppers"}}:::pain
  P4{{"Pain 4: uplift ignores shoppers who would buy anyway"}}:::pain
  A2 -.- P1
  S1 -.- P2
  M2 -.- P3
  F1 -.- P4
  classDef pain fill:#ffe1e1,stroke:#d03b3b,color:#16191d
